# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/

# Runtime artifacts (later phases)
logs/
*.log
botpy.log*
database/*.db
database/*.sqlite3

# Secrets — never commit credentials
.env
*.key
secrets.yaml

# Frontend: dependencies and build output (rebuild with `npm run build`)
node_modules/
.npm-cache/
jarvis/ui/web/

# Generated demo media — reproduce with scripts/record_demo.py
commercial/assets/demo/
assets/*.wav

# Local agent/tool scratch, not part of the project
.workbuddy/
.workbuddy-ai/

# 与本项目无关的遗留产物（别处的 SVG 动画 demo），留在磁盘但不进公开仓库。
# 本地 main 分支仍跟踪它；要彻底清理请手工确认后删除文件本身。
pelican_bicycle_animation.html

# pytest basetemp left by a debugging run
.ptmp/

# 人物模型是投放件，不是仓库内容：10 MB 二进制不进 git，换形象 = 换文件。
# 打包时由 Vite 的 publicDir 原样拷进 jarvis/ui/web/avatar/。
frontend/public/avatar/
assets-src/*.vrm

# 每轮验收抓的窗口截图（docs/desktop-operations.md 按文件名引用它们）。
# 它们是"当时那一屏"的证据，不是界面素材，所以留在磁盘不进仓库。
/r[0-9]*-*.png

# 公开分支整目录排除：报价、需求确认单、文案、演示脚本都不对外。
# 本地 main 分支仍然跟踪它们，这个改动只存在于 public-main。
commercial/
