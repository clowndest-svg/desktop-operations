# QQ official bot credentials (QQ开放平台 -> 开发设置)
QQBOT_APPID=
QQBOT_APPSECRET=

# OpenAI-compatible model endpoint. The client appends /chat/completions.
QQBOT_LLM_BASE_URL=https://api.openai.com/v1
QQBOT_LLM_MODEL=deepseek-v4-flash
QQBOT_LLM_API_KEY=

# Optional behavior
QQBOT_SYSTEM_PROMPT=你是一个可靠、简洁的 QQ 助手。使用中文回答，除非用户要求其他语言。
QQBOT_MAX_HISTORY=12
QQBOT_MAX_REPLY_CHARS=1800
JARVIS_QQBOT_REQUEST_TIMEOUT=60
